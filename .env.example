# Copy to .env and edit. .env is gitignored; this file is not, so it must never hold a
# real credential.
#
# There is no application signing key to set. Session and password-reset tokens are random
# 256-bit values stored as SHA-256 digests, so nothing is signed and there is no secret
# whose leak would forge a session. See backend/settings.py.

# development | production
# `production` enables the configuration checks in backend/settings.py:validate(), which
# refuse to start on a plain-http origin, a non-Secure cookie, or a SQLite database.
ENV=development

# SQLAlchemy URL. Defaults to sqlite:///<repo>/data/app.db when unset.
# Production must be Postgres: postgresql+psycopg://user:password@host:5432/medicl
# DATABASE_URL=

# Exact frontend origins, comma-separated. No wildcard — credentials are enabled and a
# browser rejects `*` on a credentialed request. Required explicitly in production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Where password-reset links point. Must be https in production.
APP_BASE_URL=http://localhost:5173

# Session cookie. COOKIE_SECURE defaults to true only when ENV=production; a Secure cookie
# is never stored over the plain-http dev server.
# SESSION_COOKIE_NAME=mda_session
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax
# SESSION_TTL_DAYS=14
# SESSION_IDLE_DAYS=7
# PASSWORD_RESET_TTL_MINUTES=30

# Only enable behind a proxy that overwrites X-Forwarded-For. A client can otherwise set it
# freely and present a new address per request, defeating every per-IP rate limit.
# TRUST_PROXY_HEADERS=false

# Interactive API docs. Off by default in production.
# DOCS_ENABLED=true

# Email. With no SMTP_HOST, password-reset links are printed to the server log instead of
# being sent — which is the intended development behaviour, not a fallback.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@example.org
# SMTP_STARTTLS=true
