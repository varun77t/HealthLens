# Data — raw datasets are re-downloadable via `python -m ml.data.download_all`
data/raw/
data/processed/

# Trained model artifacts (large binaries; reproducible from scripts/train_*.py)
models/*/*.joblib
models/*/*.pkl

# Application database — holds password hashes and any health values saved while
# testing. Recreate with `alembic upgrade head`; never commit it.
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# Secrets
.env
.env.*
!.env.example
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
build/
dist/

# Virtual envs
.venv/
venv/
env/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Notebook execution outputs (keep source notebooks, ignore nbconvert copies)
notebooks/**/*.nbconvert.ipynb

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.tsbuildinfo

# Research paper drafts — kept local so the published copy cannot match against a public repo
docs/paper/

# Local design-tool cache
frontend/.impeccable/hook.cache.json
